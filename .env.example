# EGUNSENTIA environment template.
# Copy to .env for local server processes or define these as server-side secrets
# in the deployment provider. Never commit a populated .env file.

# Auth UI/build flag. This is public configuration, NOT a credential.
VITE_AUTH_ENABLED=true

# Required for durable multi-session/online saves. Do not leave blank in production.
# Use the PostgreSQL connection string supplied by the selected database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth application settings. Generate a fresh, long random secret for this app.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
BETTER_AUTH_URL=https://YOUR-PRIVATE-APP-DOMAIN

# App-specific OAuth client issued for the deployed app by its auth broker.
# Do not reuse or expose another application's private client secret.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
GROK_AUTH_CLIENT_SECRET=REPLACE_WITH_APP_CLIENT_SECRET

# Private creator-only access. Use exact comma-separated emails and/or stable
# Better Auth user IDs. In production, no configured allowlist means deny all.
EGUNSENTIA_OWNER_EMAILS=creator@example.com
EGUNSENTIA_OWNER_IDS=

# Optional gate identity validation settings, if enabled for the deployment.
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=

# Configure one AL provider. Keep all keys on the server only.
# Existing xAI-compatible configuration:
XAI_API_KEY=
# Groq-compatible configuration:
GROQ_API_KEY=
# Optional generic OpenAI-compatible override (takes precedence when set):
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FALLBACK_MODELS=

# Optional server-side connector integration; not required for the core game.
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# Optional client-visible STUN URL list for peer-to-peer features.
# These are endpoint URLs, not secret credentials.
VITE_STUN_URLS=

# Optional and ephemeral: only for a non-production Vercel Preview smoke test.
# Never set this in Production. A Neon DATABASE_URL is the correct online setup.
PGLITE_ALLOW_EPHEMERAL=false
